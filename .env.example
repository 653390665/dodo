# ============================================================
# InkFlow 运行时环境变量
#
# 覆盖顺序：本文件（env）只提供「初始默认值」。应用内设置保存后会
# 落库到 ~/.inkflow/config.json，其优先于 env（加载逻辑见
# server/lib/config.ts：{ ...defaults, ...parsed }）。例外：
# INKFLOW_WRITER_MODEL 环境变量优先于 config.writerModel / config.model。
# 配置目录本身可用 INKFLOW_CONFIG_DIR 重定向。
# 以下变量全部可选，按需取消注释。
# ============================================================

# --- 模型接入（BYOK） ---
API_KEY="your-api-key"                      # 用户自带 API Key（初始默认，落库后以应用内设置为准）
API_BASE_URL="https://api.deepseek.com"     # OpenAI 兼容接口地址；代码默认 Google Generative Language
API_MODEL="deepseek-chat"                   # 默认对话/写作模型

# --- 服务与端口 ---
# PORT="3000"                               # 服务监听端口（默认 3000）
# INKFLOW_FIXED_PORT="true"                 # 禁止端口被占时自动换端口重试（默认允许重试）

# --- 数据与配置目录 ---
# INKFLOW_DB_PATH=""                        # SQLite 数据库路径（默认 ~/.inkflow/data.db）
# INKFLOW_CONFIG_DIR=""                     # 配置目录（默认 ~/.inkflow；NODE_ENV=test 时自动用临时目录）

# --- 鉴权与 Electron 打包 ---
# INKFLOW_ENABLE_DEV_AUTH_TOKEN="true"      # 仅非 production 生效：启用开发令牌鉴权（npm run dev 已默认开启）
# INKFLOW_ELECTRON_MODE="true"              # Electron 打包模式：API Key 经 INKFLOW_SECURE_API_KEY 传递，不写入 config.json
# INKFLOW_SECURE_API_KEY=""                 # Electron 模式下经进程环境注入的 API Key（不落磁盘）

# --- 商业化实验 ---
# INKFLOW_ENABLE_MONETIZATION="true|false"  # 配额/权益门禁开关；未设置时仅 NODE_ENV=test 下默认开启

# --- 生成管线调优 ---
# INKFLOW_WRITER_MODEL=""                   # 写作阶段专用模型（优先级：本变量 > config.writerModel > config.model）
# INKFLOW_WRITER_TIMEOUT_MS="90000"         # 写作阶段 LLM 超时毫秒数（默认 90000；>0 才生效）

# --- 诊断与部署 ---
# INKFLOW_VALIDATION_DEBUG="1"              # 仅非 production 生效：打印请求校验失败明细
# INKFLOW_STATIC_DIR=""                     # 生产模式静态资源目录（默认 <cwd>/dist）

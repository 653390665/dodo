// 生命周期状态机：哪些状态真的在迁移，哪些只是躺在类型里
// 生产者：flow-visualizer + graphviz
// 判读规则（重要）：
//   实线箭头   = 迁移已被行为证据确认（写函数 / 路由 / SQL UPDATE / 测试断言）
//   dotted     = 状态字面量存在，但未找到任何写入代码 —— 不得当作业务事实
//   note 框    = 该机的权威边界说明或未决问题
// 证据：inkflow.evidence.md §B（含逐条 file:line）

digraph lifecycle_states {
    rankdir=TB;
    newrank=true;
    splines=true;
    nodesep=0.45;
    ranksep=0.8;
    fontname="Helvetica";
    fontsize=13;
    labelloc=t;
    label="InkFlow 生命周期实态\n「结构上支持某个状态」≠「系统会把对象迁到该状态」";

    node [fontname="Helvetica", fontsize=11, shape=ellipse, style="filled"];
    edge [fontname="Helvetica", fontsize=10];

    // ==================== ① 裁决类：迁移证据完整 ====================
    subgraph cluster_adjudication {
        label="① 裁决类状态机（行为证据完整，含幂等与回滚测试）";
        fontsize=13; color="#66bb6a"; fontcolor="#66bb6a"; style="rounded,dashed"; bgcolor="#0d1f12";

        subgraph cluster_patch {
            label="canon_patches（大纲 Canon 变更）";
            fontsize=11; color="#66bb6a"; fontcolor="#a5d6a7"; style=rounded;
            p_pending [label="pending", fillcolor="#4a3208", fontcolor="#ffe082"];
            p_accept  [label="accepted", fillcolor="#1b5e20", fontcolor="#c8e6c9"];
            p_reject  [label="rejected", fillcolor="#4a1414", fontcolor="#ef9a9a"];
            p_stale   [label="stale\n基线指纹已过期", fillcolor="#37474f", fontcolor="#b0bec5"];
            p_pending -> p_accept  [label="accept + CAS 通过\n（重复 accept 幂等返回）", color="#66bb6a"];
            p_pending -> p_reject  [label="reject（重复 reject 幂等）", color="#66bb6a"];
            p_pending -> p_stale   [label="CAS 不符", color="#66bb6a"];
            p_accept  -> p_accept  [label="终态再 accept → CANON_PATCH_TERMINAL 之外幂等", style=dashed, color="#9e9e9e"];
        }

        subgraph cluster_cand {
            label="creative_artifact_candidates（设定结构化核）";
            fontsize=11; color="#66bb6a"; fontcolor="#a5d6a7"; style=rounded;
            c_pending [label="pending", fillcolor="#4a3208", fontcolor="#ffe082"];
            c_accept  [label="accepted", fillcolor="#1b5e20", fontcolor="#c8e6c9"];
            c_reject  [label="rejected", fillcolor="#4a1414", fontcolor="#ef9a9a"];
            c_stale   [label="stale", fillcolor="#37474f", fontcolor="#b0bec5"];
            c_pending -> c_accept [label="UPDATE ... AND status='pending'", color="#66bb6a"];
            c_pending -> c_reject [color="#66bb6a"];
            c_pending -> c_stale  [label="指纹或版本 CAS 不符", color="#66bb6a"];
        }

        subgraph cluster_outline {
            label="outline_artifacts（权威大纲版本）";
            fontsize=11; color="#66bb6a"; fontcolor="#a5d6a7"; style=rounded;
            o_cand  [label="candidate", fillcolor="#4a3208", fontcolor="#ffe082"];
            o_act   [label="active", fillcolor="#1b5e20", fontcolor="#c8e6c9"];
            o_arch  [label="archived", fillcolor="#37474f", fontcolor="#b0bec5"];
            o_cand -> o_act  [label="activateOutlineArtifactInTransaction", color="#66bb6a"];
            o_act  -> o_arch [label="replace-outline 时旧主纲让位", color="#66bb6a"];
        }

        subgraph cluster_run {
            label="chapter_production_runs（章节生产）";
            fontsize=11; color="#ffcc80"; fontcolor="#ffcc80"; style=rounded;
            r_run   [label="running", fillcolor="#4a3208", fontcolor="#ffe082"];
            r_rev   [label="review_required", fillcolor="#4a3208", fontcolor="#ffe082"];
            r_app   [label="applied", fillcolor="#1b5e20", fontcolor="#c8e6c9"];
            r_fail  [label="failed", fillcolor="#4a1414", fontcolor="#ef9a9a"];
            r_rej   [label="rejected", fillcolor="#2a2a2a", fontcolor="#9e9e9e", style="filled,dotted"];
            r_run  -> r_rev  [label="生成完成待裁决", color="#66bb6a"];
            r_run  -> r_fail [color="#66bb6a"];
            r_rev  -> r_app  [label="apply 通过全部 CAS", color="#66bb6a"];
            r_rev  -> r_fail [color="#66bb6a"];
            r_rev  -> r_rej  [label="字面量存在，无任何写入代码", style=dotted, color="#9e9e9e"];
        }
    }

    // ==================== ② 作业 / 流程类 ====================
    subgraph cluster_jobs {
        label="② 作业与流程（含崩溃恢复与断点续跑）";
        fontsize=13; color="#4dd0e1"; fontcolor="#4dd0e1"; style="rounded,dashed"; bgcolor="#0f2a33";

        subgraph cluster_job {
            label="continuation_extraction_jobs（资料解析作业）";
            fontsize=11; color="#4dd0e1"; fontcolor="#80deea"; style=rounded;
            j_q  [label="queued", fillcolor="#1b3a4b", fontcolor="#e1f5fe"];
            j_r  [label="running", fillcolor="#1b3a4b", fontcolor="#e1f5fe"];
            j_c  [label="completed", fillcolor="#1b5e20", fontcolor="#c8e6c9"];
            j_f  [label="failed", fillcolor="#4a1414", fontcolor="#ef9a9a"];
            j_x  [label="cancelled", fillcolor="#37474f", fontcolor="#b0bec5"];
            j_i  [label="interrupted\n启动清扫置位", fillcolor="#4a3208", fontcolor="#ffe082"];
            j_q -> j_r [color="#4dd0e1"];
            j_r -> j_c [color="#4dd0e1"];
            j_r -> j_f [color="#4dd0e1"];
            j_r -> j_x [label="cancel", color="#4dd0e1"];
            j_q -> j_i [label="进程重启：UPDATE ... WHERE status IN (running,queued)", style=dashed, color="#ff8a65"];
            j_r -> j_i [style=dashed, color="#ff8a65"];
            j_i -> j_r [label="resume（batch_cursor + checkpoint_json）", color="#66bb6a"];
        }

        subgraph cluster_pack {
            label="continuation_packs（资料包裁决 + 同步态）";
            fontsize=11; color="#4dd0e1"; fontcolor="#80deea"; style=rounded;
            k_draft [label="draft", fillcolor="#4a3208", fontcolor="#ffe082"];
            k_appr  [label="approved", fillcolor="#1b5e20", fontcolor="#c8e6c9"];
            k_draft -> k_appr [label="approve-import\n需 canonFacts>0 且高危冲突=0\n重复 approve → 409", color="#66bb6a"];
            s_ns [label="syncState: not_started", fillcolor="#1b3a4b", fontcolor="#e1f5fe"];
            s_pt [label="partial", fillcolor="#1b3a4b", fontcolor="#e1f5fe"];
            s_sy [label="synced", fillcolor="#1b5e20", fontcolor="#c8e6c9"];
            s_st [label="stale\n内容哈希漂移", fillcolor="#37474f", fontcolor="#b0bec5"];
            s_ns -> s_pt -> s_sy [color="#4dd0e1"];
            s_sy -> s_st [label="自动判定", style=dashed, color="#ff8a65"];
            k_appr -> s_ns [label="sync-to-world 事务内再次要求 status='approved'", color="#4dd0e1"];
        }

        subgraph cluster_flow {
            label="creation_flow_sessions（受治理开书流程）";
            fontsize=11; color="#4dd0e1"; fontcolor="#80deea"; style=rounded;
            f_a [label="active\n每作品仅允许 1 个", fillcolor="#1b3a4b", fontcolor="#e1f5fe"];
            f_c [label="completed", fillcolor="#1b5e20", fontcolor="#c8e6c9"];
            f_a -> f_c [label="WHERE ... status='active'\naccept 只验证「作者已在别处确认过」\n不代写内容", color="#66bb6a"];
        }

        subgraph cluster_phase {
            label="chapter_completion_attempts.phase（有序推进）";
            fontsize=11; color="#4dd0e1"; fontcolor="#80deea"; style=rounded;
            ph1 [label="writes-flushed", fillcolor="#1b3a4b", fontcolor="#e1f5fe"];
            ph2 [label="version-created", fillcolor="#1b3a4b", fontcolor="#e1f5fe"];
            ph3 [label="deterministic-checked", fillcolor="#1b3a4b", fontcolor="#e1f5fe"];
            ph4 [label="ai-reviewed", fillcolor="#1b3a4b", fontcolor="#e1f5fe"];
            ph5 [label="facts-proposed", fillcolor="#1b5e20", fontcolor="#c8e6c9"];
            ph1 -> ph2 -> ph3 -> ph4 -> ph5 [color="#4dd0e1"];
            ph5 -> ph1 [label="倒退 → CHAPTER_COMPLETION_PHASE_REGRESSION", style=dashed, color="#ef5350"];
        }
    }

    // ==================== ③ 声明但未接线 ====================
    subgraph cluster_unwired {
        label="③ 声明态：状态值存在，迁移代码未找到（不得当成已实现的业务环节）";
        fontsize=13; color="#9e9e9e"; fontcolor="#e0e0e0"; style="rounded,dashed"; bgcolor="#1c1c1c";

        u_fores [label="foreshadowings.status\nplanted / hinted / payoff\n全仓未见直接赋字面量，仅派生计算", fillcolor="#33272a", fontcolor="#f8bbd0"];
        u_idea  [label="idea_fragments.status\nraw → expanded 已证实\n'converted' 无写入方", fillcolor="#33272a", fontcolor="#f8bbd0"];
        u_setup [label="SetupTaskStatus\n'empty' / 'drafted' 已证实\n'confirmed' 无写入方", fillcolor="#33272a", fontcolor="#f8bbd0"];
        u_rev   [label="ReviewIssue.status\n7 个字面量，仅前端置位\n无任何服务端路由改写", fillcolor="#33272a", fontcolor="#f8bbd0"];
        u_novel [label="novels.status\nongoing / completed / hiatus\n仅 CRUD 透传，无状态机代码", fillcolor="#33272a", fontcolor="#f8bbd0"];
    }

    note1 [label="判读：①② 可用于推理改动影响面；③ 只能作为「待验证」，\n把它当既有业务流程来改会凭空发明行为。", shape=note, fillcolor="#3a2f00", fontcolor="#fff176", style=filled];
    u_novel -> note1 [style=invis];
}
